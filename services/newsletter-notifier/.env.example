# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Brevo transactional API key (Brevo dashboard -> SMTP & API -> API Keys)
BREVO_API_KEY=

# GCP project/dataset holding the subscriber data (shared with the site's
# contact form; see SPEC.md "Open Questions" #1 for why this table is filtered)
BQ_PROJECT=nlp-api-test-260216
BQ_CONTACTS_TABLE=nlp-api-test-260216.website_requests.contact_form
BQ_UNSUBSCRIBES_TABLE=nlp-api-test-260216.website_requests.newsletter_unsubscribes

# HMAC secret for per-subscriber unsubscribe tokens (tokens.py).
# Must be IDENTICAL to the UNSUBSCRIBE_SIGNING_KEY the deployed unsubscribe
# Cloud Function reads from Secret Manager — a mismatch silently breaks
# every unsubscribe link already sent out.
UNSUBSCRIBE_SIGNING_KEY=

# Base URL the unsubscribe link is built against (the deployed Cloud
# Function's URL once Task 9 is done).
UNSUBSCRIBE_BASE_URL=

# Sending domain is still an open question (SPEC.md Open Questions #2) —
# SPF/DKIM/DMARC setup isn't resolved yet. Don't do a real (non-dry-run)
# send until that's settled.
